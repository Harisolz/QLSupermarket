
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Tổng quan";

    string Active(string name) =>
        controller.Equals(name, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - QLSupermarket</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/QLSupermarket.styles.css"
          asp-append-version="true" />
</head>

<body>
    <!-- SIDEBAR -->
    <aside class="app-sidebar" id="appSidebar">

        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="bi bi-basket2-fill"></i>
            </div>

            <div>
                <div class="brand-title">QLSupermarket</div>
                <div class="brand-subtitle">Management System</div>
            </div>
        </div>

        <nav class="sidebar-menu"
             aria-label="Menu quản lý">

            <div class="sidebar-label">TỔNG QUAN</div>

            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-link @Active("Home")">
                <i class="bi bi-grid-1x2"></i>
                <span>Dashboard</span>
            </a>

            <div class="sidebar-label mt-4">
                QUẢN LÝ SIÊU THỊ
            </div>

            <a asp-controller="Categories"
               asp-action="Index"
               class="sidebar-link @Active("Categories")">
                <i class="bi bi-tags"></i>
                <span>Danh mục</span>
            </a>

            <a asp-controller="Products"
               asp-action="Index"
               class="sidebar-link @Active("Products")">
                <i class="bi bi-box-seam"></i>
                <span>Sản phẩm</span>
            </a>

            <a asp-controller="Orders"
               asp-action="Index"
               class="sidebar-link @Active("Orders")">
                <i class="bi bi-receipt"></i>
                <span>Đơn hàng</span>
            </a>

            <a asp-controller="OrderDetails"
               asp-action="Index"
               class="sidebar-link @Active("OrderDetails")">
                <i class="bi bi-list-check"></i>
                <span>Chi tiết đơn hàng</span>
            </a>

            <div class="sidebar-label mt-4">HỆ THỐNG</div>

            <a asp-controller="Users"
               asp-action="Index"
               class="sidebar-link @Active("Users")">
                <i class="bi bi-people"></i>
                <span>Người dùng</span>
            </a>

            <a asp-controller="Roles"
               asp-action="Index"
               class="sidebar-link @Active("Roles")">
                <i class="bi bi-shield-lock"></i>
                <span>Vai trò</span>
            </a>

        </nav>

        <div class="sidebar-footer">
            <div class="user-avatar">
                <i class="bi bi-person-fill"></i>
            </div>

            <div class="user-info">
                <strong>
                    @(User.Identity?.IsAuthenticated == true
                        ? User.Identity.Name
                        : "Chưa đăng nhập")
                </strong>
                <small>
                    @(User.IsInRole("Admin")
                        ? "Quản trị viên"
                        : User.IsInRole("Staff")
                            ? "Nhân viên"
                            : "Tài khoản khách")
                </small>
            </div>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- MAIN -->
    <div class="app-main">

        <header class="app-header">
            <div class="header-left">
                <button type="button"
                        class="menu-toggle"
                        id="sidebarToggle"
                        aria-label="Mở hoặc đóng menu"
                        aria-controls="appSidebar"
                        aria-expanded="false">
                    <i class="bi bi-list"></i>
                </button>

                <div>
                    <h1 class="header-title">@pageTitle</h1>
                    <p class="header-subtitle">
                        Hệ thống quản lý siêu thị
                    </p>
                </div>
            </div>

            <div class="header-right">
                <span class="header-date d-none d-md-inline">
                    <i class="bi bi-calendar3 me-1"></i>
                    @DateTime.Now.ToString("dd/MM/yyyy")
                </span>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="btn account-button dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <i class="bi bi-person-circle me-1"></i>
                            @User.Identity.Name
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <span class="dropdown-item-text">
                                    @User.Identity.Name
                                </span>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-primary btn-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Đăng nhập
                    </a>
                }
            </div>
        </header>

        <main class="app-content">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="alert">
                    <i class="bi bi-check-circle me-2"></i>
                    @TempData["Success"]
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Đóng"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @TempData["Error"]
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Đóng"></button>
                </div>
            }

            @RenderBody()

        </main>

        <footer class="app-footer">
            <span>© 2026 QLSupermarket</span>
            <span>Hệ thống quản lý siêu thị</span>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script>
        (() => {
            const toggle = document.getElementById("sidebarToggle");
            const overlay = document.getElementById("sidebarOverlay");
            const sidebar = document.getElementById("appSidebar");

            function closeSidebar() {
                document.body.classList.remove("sidebar-open");
                toggle.setAttribute("aria-expanded", "false");
            }

            toggle.addEventListener("click", () => {
                const isOpen = document.body.classList.toggle("sidebar-open");
                toggle.setAttribute("aria-expanded", String(isOpen));
            });

            overlay.addEventListener("click", closeSidebar);

            sidebar.querySelectorAll(".sidebar-link")
                .forEach(link => {
                    link.addEventListener("click", closeSidebar);
                });

            document.addEventListener("keydown", e => {
                if (e.key === "Escape") closeSidebar();
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
