@model QLSupermarket.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Đăng nhập - QLSupermarket</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
</head>

<body>
    <div class="login-container">

        <!-- LEFT PANEL -->
        <div class="login-brand">
            <div class="brand-logo">
                <i class="bi bi-basket2-fill"></i>
                <span>QLSupermarket</span>
            </div>

            <div class="brand-content">
                <div class="brand-symbol">
                    <i class="bi bi-shop-window"></i>
                </div>

                <h1>Quản lý siêu thị<br />thông minh hơn</h1>

                <p>
                    Quản lý hàng hóa, đơn hàng, nhân viên
                    và hoạt động kinh doanh trên một nền tảng.
                </p>
            </div>

            <div class="brand-footer">
                © 2026 QLSupermarket
            </div>
        </div>

        <!-- RIGHT PANEL -->
        <div class="login-panel">
            <div class="login-box">

                <div class="login-heading">
                    <span class="welcome-badge">
                        <i class="bi bi-shield-check"></i>
                        HỆ THỐNG NỘI BỘ
                    </span>

                    <h2>Chào mừng trở lại!</h2>
                    <p>
                        Đăng nhập để tiếp tục quản lý siêu thị.
                    </p>
                </div>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Username"
                               class="form-label">
                            Tên đăng nhập
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>

                            <input asp-for="Username"
                                   class="form-control"
                                   placeholder="Nhập tên đăng nhập"
                                   autocomplete="username" />
                        </div>

                        <span asp-validation-for="Username"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password"
                               class="form-label">
                            Mật khẩu
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>

                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu"
                                   autocomplete="current-password" />

                            <button class="btn password-toggle"
                                    type="button"
                                    id="togglePassword"
                                    aria-label="Hiện mật khẩu"
                                    aria-pressed="false">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <span asp-validation-for="Password"
                              class="text-danger small"></span>
                    </div>

                    <div class="remember-row">
                        <div class="form-check">
                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label">
                                Ghi nhớ đăng nhập
                            </label>
                        </div>
                    </div>

                    <button type="submit"
                            class="btn-login">
                        <span>Đăng nhập</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </form>

                <div class="login-note">
                    <i class="bi bi-info-circle"></i>
                    Tài khoản do quản trị viên hệ thống cấp.
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
            const toggle = document.getElementById("togglePassword");
            const password = document.getElementById("Password");

            toggle.addEventListener("click", () => {
                const visible = password.type === "text";

                password.type = visible ? "password" : "text";
                toggle.setAttribute("aria-pressed", String(!visible));
                toggle.setAttribute(
                    "aria-label",
                    visible ? "Hiện mật khẩu" : "Ẩn mật khẩu"
                );

                toggle.querySelector("i").className =
                    visible ? "bi bi-eye" : "bi bi-eye-slash";
            });
    </script>
</body>
</html>
